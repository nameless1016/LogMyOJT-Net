@implements IDisposable
@inject UserState State
@inject OjtState Ojt
@inject NavigationManager Nav

<header class="relative z-30 bg-bar text-cream">
    <div class="flex h-[71px] items-center gap-6 px-5 md:px-8">
        <a href="/home" class="brand-mark shrink-0">LOG·MY·OJT</a>

        <nav class="hidden items-center gap-8 md:flex" aria-label="Main">
            @foreach (var t in Tabs)
            {
                <NavLink href="@t.Href" class="tab" ActiveClass="tab-active">
                    <Icon Name="@t.Icon" /> @t.Label
                </NavLink>
            }
        </nav>

        <div class="ml-auto flex items-center gap-1">
            <div class="relative">
                <button type="button" class="relative rounded-md p-2 text-cream/80 transition-colors hover:bg-cream/10" aria-label="Reminders" @onclick='() => Toggle("bell")'>
                    <Icon Name="bell" Class="h-[18px] w-[18px]" />
                    @if (reminders.Any(r => r.Tone == "warn"))
                    {
                        <span class="absolute right-1.5 top-1.5 h-2 w-2 rounded-full border-2 border-bar bg-accent"></span>
                    }
                </button>
                @if (open == "bell")
                {
                    <div class="menu w-[300px] max-w-[85vw]">
                        <div class="eyebrow px-3 pb-1 pt-2">Reminders</div>
                        @if (reminders.Count == 0)
                        {
                            <p class="px-3 py-3 text-sm text-muted">Nothing to do right now.</p>
                        }
                        @foreach (var r in reminders)
                        {
                            <div class="flex items-start gap-2.5 rounded px-3 py-2">
                                <span class="@(r.Tone == "warn" ? "text-accent" : "text-ok") mt-0.5"><Icon Name="@r.Icon" /></span>
                                <div>
                                    <div class="text-sm font-medium text-body">@r.Title</div>
                                    <div class="text-[12.5px] text-muted">@r.Detail</div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="relative">
                <button type="button" class="flex items-center gap-2 rounded-md px-2 py-1.5 font-mono text-[13px] text-cream/90 transition-colors hover:bg-cream/10"
                        aria-haspopup="true" aria-expanded="@(open == "user" ? "true" : "false")" @onclick='() => Toggle("user")'>
                    <span class="flex h-[26px] w-[26px] shrink-0 items-center justify-center overflow-hidden rounded-full bg-cream/15 text-[11.5px] font-semibold">
                        @if (State.ProfileImage is not null)
                        {
                            <img src="@State.ProfileImage" alt="" class="h-full w-full object-cover" />
                        }
                        else
                        {
                            @State.Initial
                        }
                    </span>
                    <span class="hidden sm:inline">@State.DisplayName</span>
                    <span class="@(open == "user" ? "rotate-180" : "") text-[9px] text-cream/50 transition-transform">▾</span>
                </button>
                @if (open == "user")
                {
                    <div class="menu">
                        <a href="/profile" class="menu-item" @onclick="Close"><Icon Name="user" Class="h-4 w-4 text-soft" /> Profile</a>
                        <a href="/settings" class="menu-item" @onclick="Close"><Icon Name="sliders" Class="h-4 w-4 text-soft" /> Settings</a>
                        <div class="mx-1 my-1.5 h-px bg-line"></div>
                        <button type="button" class="menu-item" @onclick="LogOut"><Icon Name="logout" Class="h-4 w-4 text-soft" /> Log out</button>
                    </div>
                }
            </div>

            <button type="button" class="rounded-md p-2 text-cream/80 transition-colors hover:bg-cream/10 md:hidden" aria-label="Menu" @onclick='() => Toggle("mobile")'>
                <Icon Name="@(open == "mobile" ? "x" : "menu")" Class="h-5 w-5" />
            </button>
        </div>
    </div>

    @if (open == "mobile")
    {
        <nav class="border-t border-cream/10 px-5 pb-3 pt-2 md:hidden" aria-label="Main">
            @foreach (var t in Tabs)
            {
                <NavLink href="@t.Href" class="flex items-center gap-2.5 rounded px-2 py-3 text-[15px] text-cream/70" ActiveClass="!text-cream font-semibold" @onclick="Close">
                    <Icon Name="@t.Icon" Class="h-[18px] w-[18px]" /> @t.Label
                </NavLink>
            }
        </nav>
    }
</header>

@* clicking anywhere outside closes whatever menu is open *@
@if (open != "")
{
    <div class="fixed inset-0 z-20" @onclick="Close"></div>
}

@code {
    private record Tab(string Label, string Href, string Icon);

    private static readonly Tab[] Tabs =
    {
        new("Dashboard", "/home", "grid"),
        new("Time logs", "/time-logs", "clock"),
        new("Placement", "/placement", "briefcase"),
        new("Reports", "/reports", "file"),
    };

    private string open = "";
    private List<Reminder> reminders = new();

    protected override void OnInitialized()
    {
        State.Changed += OnChanged;
        Refresh();
    }

    protected override void OnParametersSet() => Refresh();

    private void Refresh() => reminders = Ojt.Reminders(DateOnly.FromDateTime(DateTime.Now));

    private void OnChanged() => InvokeAsync(() => { Refresh(); StateHasChanged(); });

    private void Toggle(string menu)
    {
        Refresh();
        open = open == menu ? "" : menu;
    }

    private void Close() => open = "";

    private void LogOut()
    {
        open = "";
        State.Clear();
        Ojt.Clear();
        State.Notify();
        Nav.NavigateTo("/login");
    }

    public void Dispose() => State.Changed -= OnChanged;
}
