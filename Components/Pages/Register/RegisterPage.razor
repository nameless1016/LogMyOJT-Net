@page "/register"
@inject UserState State
@inject NavigationManager Nav

<PageTitle>Create Account · LogMyOJT</PageTitle>

<AuthShell Headline="Set up in minutes. Log hours from day one."
           Blurb="Add your placement details once — company, supervisor, required hours — and the tally runs itself for the rest of the term."
           Foot="Built for OJT, practicum & internship placements"
           Rows="rows">
    <p class="mb-1.5 font-mono text-[0.78rem] text-muted">Get started</p>
    <h2 class="mb-1.5 font-serif text-[1.8rem] font-medium text-fg">Create your account</h2>
    <p class="mb-8 text-[0.95rem] leading-normal text-muted">One account per student — your logs stay private to you.</p>

    @if (errors.Count > 0)
    {
        <div class="alert-error">
            <ul class="list-disc pl-4">
                @foreach (var err in errors)
                {
                    <li>@err</li>
                }
            </ul>
        </div>
    }

    <form @onsubmit="CreateAccount" @onsubmit:preventDefault>
        <div class="mb-4">
            <label for="id_last_name" class="label">Last name</label>
            <input type="text" id="id_last_name" class="input" placeholder="Dela Cruz" @bind="lastName" @bind:event="oninput" />
        </div>
        <div class="mb-4">
            <label for="id_first_name" class="label">First name</label>
            <input type="text" id="id_first_name" class="input" placeholder="Juan" @bind="firstName" @bind:event="oninput" />
        </div>
        <div class="mb-4">
            <label for="id_username" class="label">Username</label>
            <input type="text" id="id_username" class="input" placeholder="Choose a username" @bind="username" @bind:event="oninput" />
        </div>
        <div class="mb-4">
            <label for="id_email" class="label">School email</label>
            <input type="email" id="id_email" class="input" placeholder="you@school.edu" @bind="email" @bind:event="oninput" />
        </div>
        <div class="mb-4">
            <label for="id_password" class="label">Password</label>
            <input type="password" id="id_password" class="input" placeholder="Create a password" @bind="password" @bind:event="oninput" />
            <div class="help">At least 8 characters.</div>
        </div>
        <div class="mb-5">
            <label for="id_password_confirm" class="label">Confirm password</label>
            <input type="password" id="id_password_confirm" class="input" placeholder="Confirm your password" @bind="passwordConfirm" @bind:event="oninput" />
        </div>
        <button type="submit" class="btn-primary w-full active:scale-[0.99]">Create account</button>
    </form>

    <p class="mt-6 text-center text-sm text-muted">Already logging hours? <a href="/login" class="font-semibold text-accent hover:underline">Sign in</a></p>
</AuthShell>

@code {
    private string lastName = "";
    private string firstName = "";
    private string username = "";
    private string email = "";
    private string password = "";
    private string passwordConfirm = "";
    private List<string> errors = new();

    private static readonly AuthShell.LedgerRow[] rows =
    {
        new("Req.", "Total hours needed", "486 hrs", false),
        new("Sup.", "Digital approval link", "enabled", true),
        new("Rep.", "Submission-ready CSV", "ready", true),
    };

    private void CreateAccount()
    {
        errors = new List<string>();

        if (string.IsNullOrWhiteSpace(lastName)) errors.Add("Last name is required.");
        if (string.IsNullOrWhiteSpace(firstName)) errors.Add("First name is required.");
        if (string.IsNullOrWhiteSpace(username)) errors.Add("Username is required.");
        if (string.IsNullOrWhiteSpace(email)) errors.Add("Email is required.");
        if (password.Length < 8)
            errors.Add("Password must be at least 8 characters.");
        else if (password != passwordConfirm)
            errors.Add("Passwords do not match.");

        if (errors.Count > 0) return;

        // nothing is stored yet, we just remember the names for this session
        State.Username = username.Trim();
        State.FirstName = firstName.Trim();
        State.LastName = lastName.Trim();
        State.SignedIn = true;
        State.Notify();
        Nav.NavigateTo("/home");
    }
}
