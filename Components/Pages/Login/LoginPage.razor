@page "/"
@page "/login"
@inject UserState State
@inject NavigationManager Nav

<PageTitle>Sign In · LogMyOJT</PageTitle>

<AuthShell Headline="Your internship hours, tracked to the minute."
           Blurb="No more paper logbooks or lost signatures. Time in, time out, and a running tally your supervisor can approve with one click."
           Foot="142 / 486 hours logged this term"
           Rows="rows">
    <p class="mb-1.5 font-mono text-[0.78rem] text-muted">Welcome back</p>
    <h2 class="mb-1.5 font-serif text-[1.8rem] font-medium text-fg">Sign in</h2>
    <p class="mb-8 text-[0.95rem] leading-normal text-muted">Pick up where you left off — your logs and reports are waiting.</p>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert-error">@error</div>
    }

    <form @onsubmit="SignIn" @onsubmit:preventDefault>
        <div class="mb-4">
            <label for="id_username" class="label">Username</label>
            <input type="text" id="id_username" class="input" placeholder="Your username" @bind="username" @bind:event="oninput" />
        </div>
        <div class="mb-5">
            <label for="id_password" class="label">Password</label>
            <input type="password" id="id_password" class="input" placeholder="Your password" @bind="password" @bind:event="oninput" />
        </div>
        <button type="submit" class="btn-primary w-full active:scale-[0.99]">Sign in</button>
    </form>

    <p class="mt-6 text-center text-sm text-muted">New to LogMyOJT? <a href="/register" class="font-semibold text-accent hover:underline">Create an account</a></p>
</AuthShell>

@code {
    private string username = "";
    private string password = "";
    private string? error;

    private static readonly AuthShell.LedgerRow[] rows =
    {
        new("Mon", "08:58 AM  →  05:02 PM", "approved", true),
        new("Tue", "09:01 AM  →  05:00 PM", "approved", true),
        new("Wed", "09:00 AM  →  —", "pending", false),
    };

    // no accounts exist yet (no database), so any username and password gets you in
    private void SignIn()
    {
        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            error = "Enter your username and password.";
            return;
        }

        State.Username = username.Trim();
        State.SignedIn = true;
        State.Notify();
        Nav.NavigateTo("/home");
    }
}
