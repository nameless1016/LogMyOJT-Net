@page "/settings"
@inherits SignedInPage

<PageTitle>Settings · LogMyOJT</PageTitle>

<main class="page">
    <div class="card mx-auto w-full max-w-[480px] p-9">
        <h1 class="font-serif text-[1.7rem] font-medium text-fg">Settings</h1>
        <p class="mb-4 mt-1 text-[14.7px] text-muted">Control how LogMyOJT looks and notifies you.</p>

        <Toggle Label="Dark mode" Help="Switch the interface to a darker theme."
                Value="State.DarkMode" ValueChanged="SetDark" />
        <Toggle Label="Email notifications" Help="Get notified when a supervisor approves an entry."
                Value="State.EmailNotifications" ValueChanged="SetEmail" />
    </div>
</main>

@code {
    private void SetDark(bool on)
    {
        State.DarkMode = on;
        State.Notify();
    }

    private void SetEmail(bool on) => State.EmailNotifications = on;
}
